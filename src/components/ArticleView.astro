---
import { render, type CollectionEntry } from "astro:content";
import { getImageUrl } from "@utils/image";
import slugify from "@utils/slugify";
import SiteHeader from "@components/SiteHeader.astro";
import CornerSocials from "@components/CornerSocials.astro";

interface BlogArticleProps {
  collection: "blog";
  entry: CollectionEntry<"blog">;
}

interface YarArticleProps {
  collection: "yar";
  entry: CollectionEntry<"yar">;
}

interface HakkaArticleProps {
  collection: "hakka";
  entry: CollectionEntry<"hakka">;
}

export type Props = BlogArticleProps | YarArticleProps | HakkaArticleProps;

const { collection, entry } = Astro.props;
const { Content } = await render(entry);

const title = entry.data.title;
const description = entry.data.description ?? null;
const tags = entry.data.tags ?? [];

let date: Date | null;
let cover: string | null;
let articleUrl: string;
let jsonLdImage: string | undefined;

if (collection === "blog") {
  date = entry.data.pubDatetime;
  cover = null;
  articleUrl = `https://rayliao.com/posts/${slugify(entry.data)}`;
  const og = entry.data.ogImage;
  const ogPath = typeof og === "string" ? og : og?.src;
  jsonLdImage = new URL(
    ogPath ?? `/posts/${slugify(entry.data)}.png`,
    Astro.url.origin
  ).href;
} else {
  date = entry.data.date ?? null;
  cover = entry.data.cover ?? null;
  articleUrl = `https://rayliao.com/${collection}/${entry.id}`;
  jsonLdImage = cover ? getImageUrl(cover) : undefined;
}

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description ?? "",
  datePublished: date?.toISOString(),
  author: { "@id": "https://rayliao.com/#person" },
  url: articleUrl,
  ...(jsonLdImage ? { image: jsonLdImage } : {}),
  keywords: tags.join(", "),
};
---

<main
  class="relative min-h-screen bg-[#fafafa] text-gray-800 dark:bg-[#1d1f21] dark:text-[#c9cacc]"
>
  <SiteHeader />
  <div class="mx-auto w-full max-w-2xl px-4 py-16 sm:px-6">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)}
    ></script>

    <article>
      <header class="mb-8">
        <h1
          class="text-3xl font-bold tracking-wide text-grass-600 dark:text-grass-400 lg:text-4xl"
        >
          {title}
        </h1>
        {
          date && (
            <time
              datetime={date.toISOString()}
              class="mt-3 block text-sm text-gray-500 dark:text-gray-400"
            >
              {date.toISOString().slice(0, 10)}
            </time>
          )
        }
        {
          description && (
            <p class="mt-4 text-base text-gray-600 dark:text-gray-300">
              {description}
            </p>
          )
        }
        {
          tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {tags.map(tag => (
                <span class="rounded-sm bg-grass-100 px-3 py-1 text-xs text-grass-800 dark:bg-grass-900 dark:text-grass-200">
                  #{tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      {
        cover && (
          <img
            src={getImageUrl(cover)}
            alt={title}
            class="mb-10 w-full rounded-lg"
          />
        )
      }

      <div
        class="prose prose-gray max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-grass-600 dark:prose-a:text-grass-400"
      >
        <Content />
      </div>
    </article>
  </div>
  <CornerSocials />
</main>