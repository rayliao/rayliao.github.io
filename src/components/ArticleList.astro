---
import { getCollection } from "astro:content";
import { COLLECTION_META, type Collection } from "@utils/collections";

export interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const meta = COLLECTION_META[collection];

const articles = (await getCollection(collection, ({ data }) => !data.draft))
  .map(entry => ({
    slug: entry.id,
    title: entry.data.title,
    date: entry.data.date ?? null,
    description: entry.data.description,
    tags: entry.data.tags,
  }))
  .sort((a, b) => {
    if (!a.date && !b.date) return a.title.localeCompare(b.title);
    if (!a.date) return 1;
    if (!b.date) return -1;
    return b.date.getTime() - a.date.getTime();
  });

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<main
  class="min-h-screen bg-[#f3f3f2] text-gray-800 dark:bg-[#272824] dark:text-gray-50"
>
  <div class="mx-auto w-full max-w-2xl px-4 py-16 sm:px-6">
    <a
      href="/"
      class="mb-10 inline-block text-sm text-gray-500 transition-colors hover:text-grass-600 dark:text-gray-400 dark:hover:text-grass-400"
    >
      ← home
    </a>

    <header class="mb-10">
      <h1
        class="text-3xl font-light tracking-wide text-grass-600 dark:text-grass-400 lg:text-4xl"
      >
        {meta.title}
      </h1>
      <p class="mt-3 text-base text-gray-600 dark:text-gray-300">
        {meta.subtitle}
      </p>
    </header>

    {
      articles.length === 0 ? (
        <p class="text-sm text-gray-500 dark:text-gray-400">暂无文章。</p>
      ) : (
        <ul class="flex flex-col gap-4">
          {articles.map(article => (
            <li>
              <a
                href={`/${collection}/${article.slug}`}
                class="group block rounded-lg border border-gray-200/70 bg-white/50 p-5 transition-colors hover:border-grass-400 dark:border-gray-700/70 dark:bg-gray-800/30 dark:hover:border-grass-500"
              >
                <div class="flex items-baseline justify-between gap-4">
                  <h2 class="text-lg font-medium leading-snug text-gray-800 transition-colors group-hover:text-grass-600 dark:text-gray-50 dark:group-hover:text-grass-400">
                    {article.title}
                  </h2>
                  {article.date && (
                    <time
                      datetime={article.date.toISOString()}
                      class="shrink-0 text-xs text-gray-500 dark:text-gray-400"
                    >
                      {formatDate(article.date)}
                    </time>
                  )}
                </div>
                {article.description && (
                  <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                    {article.description}
                  </p>
                )}
                {article.tags && article.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {article.tags.map(tag => (
                      <span class="rounded-full bg-grass-100 px-2.5 py-0.5 text-xs text-grass-800 dark:bg-grass-900 dark:text-grass-200">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</main>