---
import PersonalLayout from "@layouts/PersonalLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { getImageUrl } from "@utils/image";

const bgImage = getImageUrl("bg.jpg");
const title = "RayLiao - 前端开发 / 摄影 / 客家文化";
const description =
  "Ray Liao，前端开发者、摄影爱好者、客家文化记录者。分享技术文章、摄影作品和客家文化故事。";
---

<PersonalLayout
  title={title}
  description={description}
  canonical="https://rayliao.com"
>
  <div
    class="font-mono bg-[#f3f3f2] dark:bg-[#272824] h-screen relative text-center overflow-hidden text-gray-800 dark:text-gray-50 text-sm flex flex-col justify-center"
  >
    <SiteHeader />
    <div class="relative top-[-50px]">
      <div class="glitch">
        <div class="glitch-img" style={`background-image: url("${bgImage}")`}></div>
        <div class="glitch-img" style={`background-image: url("${bgImage}")`}></div>
        <div class="glitch-img" style={`background-image: url("${bgImage}")`}></div>
        <div class="glitch-img" style={`background-image: url("${bgImage}")`}></div>
        <div class="glitch-img" style={`background-image: url("${bgImage}")`}></div>
      </div>
      <h1
        class="font-extralight lg:font-light font-sans leading-none m-0 pt-2 tracking-[14px] lg:tracking-[30px] text-3xl lg:text-5xl uppercase relative text-grass-600"
      >
        Ray Liao
      </h1>
      <p class="font-medium mt-[2em] text-grass-500 relative">
        <span data-i18n="frontEnd">Front-end developer</span>
        &nbsp;/&nbsp;
        <span data-i18n="photography">Photography enthusiasts</span>
        &nbsp;/&nbsp;
        <span data-i18n="swimfan">Swimfan</span>
      </p>
    </div>
    <div class="absolute left-[-130px] bottom-[-130px] scale-[0.8]">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-gray-800 dark:text-gray-50 absolute top-1/2 left-1/2 mt-[-10px] ml-[-10px] w-6 h-6"
        ><path
          d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
        ></path><circle cx="12" cy="10" r="3"></circle></svg
      >
      <svg class="animate-[spin_15s_linear_infinite] w-[300px] h-[300px]">
        <defs>
          <path id="textPath" d="m61,149.99998a89,89 0 1 1 0,0.00004"></path>
        </defs>
        <text
          class="font-sans font-light text-[20px] fill-gray-800 dark:fill-gray-50 tracking-[11px]"
        >
          <textPath href="#textPath">24°01'50.4"N  116°28'40.6"E</textPath>
        </text>
      </svg>
    </div>
    <div class="absolute right-4 bottom-4 flex gap-3">
      <a
        href="https://github.com/rayliao"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-gray-800 dark:text-gray-50 hover:opacity-70 transition-opacity"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5"
          ><path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
        >
      </a>
      <a
        href="https://instagram.com/ray__liao/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="text-gray-800 dark:text-gray-50 hover:opacity-70 transition-opacity"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5"
          ><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path
            d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line
            x1="17.5"
            x2="17.51"
            y1="6.5"
            y2="6.5"></line></svg
        >
      </a>
    </div>
  </div>
</PersonalLayout>