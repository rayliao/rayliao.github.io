---
import PersonalLayout from "@layouts/PersonalLayout.astro";
import "@styles/past.css";
import { getImageUrl } from "@utils/image";

type Entry = {
  img: string;
  date: string;
  place: string;
  p: [string, string];
  rev?: boolean;
  infoFirst?: boolean;
  white?: boolean;
};

