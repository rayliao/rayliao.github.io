    ],
    rev: true,
    infoFirst: true,
    white: true,
  },
  {
    img: "201302",
    date: "February 2013",
    place: "Guangzhou",
    p: ["人像摄影练习日", "在东湖公园，丹妮是一个很好的拍照练习对象"],
  },
  {
    img: "201301",
    date: "January 2013",
    place: "Meizhou Guangdong",
    p: [
      "带表弟表妹去沙滩玩",
      "过年在家，正天气晴朗，闲来无事，跑去沙滩玩，拍照",
    ],
    rev: true,
    infoFirst: true,
    white: true,
  },
  {
    img: "201212",
    date: "December 2012",
    place: "Guangzhou",
    p: [
      "跟老刘，小彬和关羽聚餐",
      "然后在珠江边上闲逛，那天初识的情侣如今也各自各顾各的努力生活着",
    ],
  },
  {
    img: "201211",
    date: "November 2012",
    place: "Chancheng Foshan",
    p: [
      "在印象城吃寿司，田兴琅要回江苏",
      "胖子后来也回了江苏，我也离开了佛山，分离了就不知道什么时候能再见上，或许余生再也见不上",
    ],
    rev: true,
    infoFirst: true,
    white: true,
  },
  {
    img: "201210",
    date: "October 2012",
    place: "Ikea Guangzhou",
    p: [
      "和俊宙，丹妮逛宜家",
      "逛了一次宜家，就喜欢上了宜家，有些我就会喜欢上，像拍照，像你",
    ],
  },
];
---

<PersonalLayout
  title="Past"
  description="Past photography works"
  canonical="https://rayliao.com/shoot/past"
>
  <div style="background-color: hsl(71, 5%, 95%)">
    <div class="past-main">
      <div class="past-header">
        <h2>
          <a href="/">
            copyright© 2011-2016 WINGRAY LIAO, all rights reserved.
          </a>
        </h2>
        <div class="past-line">/</div>
        <div class="past-right">
          <h1><a href="/shoot/2016">WingRay Liao Photopraphy</a></h1>
          <div class="past-nav">
            <a href="/">home</a>
            <span>/</span>
            <a href="/blog">blog</a>
          </div>
        </div>
      </div>
      <div>
        {
          entries.map(entry => {
            const info = (
              <div class="past-info past-infoBlack">
                <h3>
                  {entry.date}
                  <br />
                  {entry.place}
                </h3>
                <p>{entry.p[0]}</p>
                <p>{entry.p[1]}</p>
              </div>
            );
            const pic = (
              <div class="past-pic">
                <img
                  class="absolute inset-0 h-full w-full object-contain"
                  loading="lazy"
                  src={getImageUrl(`albums/${entry.img}.jpeg`)}
                  alt={entry.img}
                />
              </div>
            );
            const white = entry.white && (
              <div class="past-info past-infoWhite">
                <div class="past-infoClip">
                  <div class="past-infoInr">
                    <h3>
                      {entry.date}
                      <br />
                      {entry.place}
                    </h3>
                    <p>{entry.p[0]}</p>
                    <p>{entry.p[1]}</p>
                  </div>
                </div>
              </div>
            );
            return (
              <div class={`past-entry ${entry.rev ? "past-rev" : ""}`}>
                {entry.infoFirst ? (
                  <>
                    {info}
                    {pic}
                    {white}
                  </>
                ) : (
                  <>
                    {pic}
                    {info}
                  </>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</PersonalLayout>