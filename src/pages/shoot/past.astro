    place: "Huizhou Guangdong",
    p: [
      "参加郝鹏的婚礼",
      "应该是来到这个公司第一次与同事外出游玩，于乡野间嬉戏，泡了温泉，玩了大喇叭",
    ],
    rev: true,
    infoFirst: true,
    white: true,
  },
  {
    img: "201408",
    date: "August 2014",
    place: "Wuchuan Zanjiang Guangdong",
    p: ["参加冠勇的婚礼", "看了海，体验了粤东的婚俗"],
