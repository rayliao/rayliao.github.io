---
import PersonalLayout from "@layouts/PersonalLayout.astro";
import ShootLayout from "@components/ShootLayout.astro";
import "@styles/shoot.css";
import { getImageUrl } from "@utils/image";

export function getStaticPaths() {
  return [2016, 2017, 2018, 2019, 2020, 2021].map(year => ({
    params: { year: String(year) },
  }));
}

const { year } = Astro.params;

const images: Record<string, (string | string[])[]> = {
  "2016": [
    "0401",
    "0402",
    "0403",
    "0405",
    "0406",
    "0407",
    "0801",
    "0802",
    ["0404", "0901"],
    "1000",
    "1001",
    "1002",
    "1004",
    "1005",
    "1006",
  ],
  "2017": ["0101", "0102", "0402", "0403", "1001", ["1002"]],
  "2018": [
    "0203",
    "0204",
    ["0619", "0620"],
    "0621",
    "0622",
    "0623",
    "0624",
    "0625",
    "0626",
    "0627",
    "0628",
    "0629",
    "0630",
    "0802",
    "1003",
    "1101",
    ["1201", "1203"],
  ],
  "2019": [
    "0120",
    "0206",
    ["0210", "0225"],
    ["0226", "0227"],
    "0228",
    "0301",
    "0316",
