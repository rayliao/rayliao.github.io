const items = images[year!];
---

<PersonalLayout
  title={`${year} Shoot`}
  description={`Photography collection from ${year}`}
  canonical={`https://rayliao.com/shoot/${year}`}
>
  <ShootLayout>
    {
      items.map(item => {
        const single = typeof item === "string";
        return (
          <div class={`shoot-item ${single ? "" : "shoot-unite"}`}>
            {single ? (
              <img
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
                alt={`${year} photo ${item}`}
                src={getImageUrl(`${year}/${item}.jpg`)}
              />
            ) : (
              item.map(n => (
                <div class="shoot-uniteItem">
                  <img
                    class="absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                    alt={`${year} photo ${n}`}
                    src={getImageUrl(`${year}/${n}.jpg`)}
                  />
                </div>
              ))
            )}
          </div>
        );
      })
    }
  </ShootLayout>
</PersonalLayout>