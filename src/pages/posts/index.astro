---
import PersonalLayout from "@layouts/PersonalLayout.astro";
import ArchiveShell from "@components/ArchiveShell.astro";
import Archive from "@components/Archive";
import getArchiveItems from "@utils/getArchiveItems";

const items = await getArchiveItems();
---

<PersonalLayout
  title="Blog - 技术博客"
  description="Ray Liao 的技术博客：生活、阅读与年度回顾。"
  canonical="https://rayliao.com/posts"
>
  <ArchiveShell>
    <Archive items={items} initialCollection="blog" client:load />
  </ArchiveShell>
</PersonalLayout>