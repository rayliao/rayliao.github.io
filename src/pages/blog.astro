---
import PersonalLayout from "@layouts/PersonalLayout.astro";
import { COLLECTION_META } from "@utils/collections";

const ENTRIES = [
  {
    title: "Blog",
    subtitle: "技术博客（生活、阅读与年度回顾）",
    href: "/posts",
  },
  {
    title: COLLECTION_META.yar.title,
    subtitle: COLLECTION_META.yar.subtitle,
    href: "/yar",
  },
  {
    title: COLLECTION_META.hakka.title,
    subtitle: COLLECTION_META.hakka.subtitle,
    href: "/hakka",
  },
];
---

<PersonalLayout
  title="Blog - 写作入口"
  description="Ray Liao 的写作入口：技术博客、Rayyar爱学习（AI 与创作）与客家文化记录。"
  canonical="https://rayliao.com/blog"
>
  <main
    class="min-h-screen bg-[#f3f3f2] text-gray-800 dark:bg-[#272824] dark:text-gray-50"
  >
    <div class="mx-auto w-full max-w-2xl px-4 py-16 sm:px-6">
      <a
        href="/"
        class="mb-10 inline-block text-sm text-gray-500 transition-colors hover:text-grass-600 dark:text-gray-400 dark:hover:text-grass-400"
      >
        ← home
      </a>

      <header class="mb-10">
        <h1
          class="text-3xl font-light tracking-wide text-grass-600 dark:text-grass-400 lg:text-4xl"
        >
          Blog
        </h1>
        <p class="mt-3 text-base text-gray-600 dark:text-gray-300">
          写作与记录的三个入口。
        </p>
      </header>

      <ul class="flex flex-col gap-4">
        {
          ENTRIES.map(entry => (
            <li>
              <a
                href={entry.href}
                class="group block rounded-lg border border-gray-200/70 bg-white/50 p-5 transition-colors hover:border-grass-400 dark:border-gray-700/70 dark:bg-gray-800/30 dark:hover:border-grass-500"
              >
                <h2 class="text-lg font-medium text-gray-800 transition-colors group-hover:text-grass-600 dark:text-gray-50 dark:group-hover:text-grass-400">
                  {entry.title}
                </h2>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
                  {entry.subtitle}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</PersonalLayout>