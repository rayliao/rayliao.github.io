# ========================
# Cloudflare R2 图片存储（推荐）
# ========================
# 公开访问地址（用于前端拼接图片 URL）
NEXT_PUBLIC_R2_URL=https://images.your-domain.com

# 上传凭证（仅脚本使用，不要泄露）
# 获取方式：R2 控制台 → 管理 R2 API 令牌
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name

# ========================
# Vercel Blob 图片存储（旧方案，保留兼容）
# ========================
# 格式：https://your-blob-url.public.blob.vercel-storage.com
NEXT_PUBLIC_BLOB_URL=https://fhfvi6akncrlhdoe.public.blob.vercel-storage.com
